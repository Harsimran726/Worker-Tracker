{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Details of a carpentry worker",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the worker" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "dailySalary": { "type": "number", "description": "Standard daily pay rate" },
        "workingHours": { "type": "number", "description": "Standard working hours per day" },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Employment status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the worker was added" },
        "ownerId": { "type": "string", "description": "UID of the user who manages this worker" }
      },
      "required": ["name", "dailySalary", "ownerId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a worker",
      "type": "object",
      "properties": {
        "workerId": { "type": "string", "description": "ID of the worker" },
        "date": { "type": "string", "format": "date", "description": "Date of attendance (YYYY-MM-DD)" },
        "status": { "type": "string", "enum": ["present", "absent", "half-day"], "description": "Attendance status" },
        "hoursWorked": { "type": "number", "description": "Actual hours worked" },
        "notes": { "type": "string", "description": "Optional notes or reason for absence" },
        "ownerId": { "type": "string", "description": "UID of the user who recorded this" }
      },
      "required": ["workerId", "date", "status", "ownerId"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Record of payment made to a worker (advance or salary)",
      "type": "object",
      "properties": {
        "workerId": { "type": "string", "description": "ID of the worker" },
        "date": { "type": "string", "format": "date-time", "description": "When the payment was made" },
        "amount": { "type": "number", "description": "Amount paid" },
        "type": { "type": "string", "enum": ["advance", "salary_payout", "deduction"], "description": "Type of payment" },
        "notes": { "type": "string", "description": "Optional notes" },
        "ownerId": { "type": "string", "description": "UID of the user who recorded this" }
      },
      "required": ["workerId", "date", "amount", "type", "ownerId"]
    },
    "Client": {
      "title": "Client",
      "description": "Details of a client",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the client" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "address": { "type": "string", "description": "Address of the project" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the client was added" },
        "ownerId": { "type": "string", "description": "UID of the user who manages this client" }
      },
      "required": ["name", "ownerId"]
    },
    "ClientTransaction": {
      "title": "Client Transaction",
      "description": "Record of amount collected from or billed to a client",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "ID of the client" },
        "amount": { "type": "number", "description": "Amount transacted" },
        "type": { "type": "string", "enum": ["received", "billed"], "description": "Type of transaction" },
        "date": { "type": "string", "format": "date-time", "description": "When the amount was transacted" },
        "paymentMethod": { "type": "string", "enum": ["cash", "online"], "description": "Method of collection" },
        "notes": { "type": "string", "description": "Optional notes" },
        "ownerId": { "type": "string", "description": "UID of the user who recorded this" }
      },
      "required": ["clientId", "amount", "date", "type", "paymentMethod", "ownerId"]
    }
  },
  "firestore": {
    "workers": {
      "schema": "Worker",
      "description": "Collection of workers managed by users"
    },
    "clients": {
      "schema": "Client",
      "description": "Collection of clients managed by users"
    },
    "attendance": {
      "schema": "Attendance",
      "description": "Historical attendance records"
    },
    "payments": {
      "schema": "Payment",
      "description": "Historical payment and advance records"
    },
    "client_transactions": {
      "schema": "ClientTransaction",
      "description": "Records of amounts transacted with clients"
    }
  }
}
